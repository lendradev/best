{
  "name": "best",
  "version": "0.1.0",
  "private": false,
  "description": "Best — a NestJS-style application framework and a Prisma-style ORM, built natively on Bun with zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  },
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./orm": "./src/orm/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "bun run src/cli/main.ts dev",
    "start": "bun run src/cli/main.ts start",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --target=bun --outdir dist --external 'bun:*'",
    "best": "bun run src/cli/main.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "keywords": [
    "bun",
    "framework",
    "orm",
    "nestjs",
    "prisma",
    "drizzle"
  ]
}
